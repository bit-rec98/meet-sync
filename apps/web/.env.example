# Read by Vite when the web app is built or started (only variables starting with VITE_ reach the browser,
# so never put a secret here).

# WebSocket address of the API's signaling endpoint. Needed in production, where the browser connects
# straight to the API host. Leave it unset in development: the address is derived from the page and goes
# through the Vite proxy.
# VITE_SIGNALING_URL=wss://api.example.com/api/v1/ws
