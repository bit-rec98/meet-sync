{
  "name": "meet-sync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Meeting suite with audio and video calls over WebRTC and WebSocket signaling.",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @meet-sync/api",
    "dev:web": "npm run dev -w @meet-sync/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:protocol": "npm run build -w @meet-sync/signaling-protocol",
    "pretest": "npm run build:protocol",
    "pretypecheck": "npm run build:protocol",
    "predev:api": "npm run build:protocol",
    "predev:web": "npm run build:protocol"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
