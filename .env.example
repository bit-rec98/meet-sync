# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.
# For the local Docker database, names and passwords may contain only letters, digits and underscores.

# --- API ---
NODE_ENV=development
# Port the API listens on (default 3000).
API_PORT=3000
# Signing key for access tokens. Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_value_of_at_least_32_characters
# Origins of the web app allowed to call cookie-authenticated routes. Comma-separated, no path or
# trailing slash, e.g. https://your-site.netlify.app. Required.
WEB_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API whose X-Forwarded-For header is trusted (default 0).
# Leave at 0 locally; set it when deploying behind a proxy so rate limits see real client addresses.
TRUST_PROXY_HOPS=0

# --- Calls (all optional) ---
# Largest number of people in one call. Calls are peer-to-peer, so every added person costs everyone
# else bandwidth and CPU: video allows far fewer than audio. Defaults: 10 audio, 4 video.
MAX_PARTICIPANTS_AUDIO=10
MAX_PARTICIPANTS_VIDEO=4
# STUN servers help browsers find their public address (comma-separated; empty for none).
# The default is a public Cloudflare server, which sees participants' IP addresses.
STUN_URLS=stun:stun.cloudflare.com:3478
# Optional TURN relay for people behind restrictive networks. Credentials are generated per user from
# the shared secret, which must match the TURN server's configuration (at least 32 characters; never
# sent to the browser). Both are needed to enable TURN. Generate a secret with: openssl rand -hex 32
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SHARED_SECRET=replace_with_a_random_value_of_at_least_32_characters

# --- Database (used by the API and by docker-compose.yml) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=meet_sync
# Database used by automated tests (the API tests apply migrations to it and delete its rows).
DB_TEST_NAME=meet_sync_test
# Runtime account used by the API: can only read and write rows (no schema changes).
DB_USER=meet_sync_app
DB_PASSWORD=replace_with_a_strong_runtime_password
# Migration account used only by `npm run migrate`: full rights on the application database.
DB_MIGRATION_USER=meet_sync_migrator
DB_MIGRATION_PASSWORD=replace_with_a_strong_migration_password
# Root password of the local Docker container only. Not used by the API.
DB_ROOT_PASSWORD=replace_with_a_strong_root_password
