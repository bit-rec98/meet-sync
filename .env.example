# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.
# For the local Docker database, names and passwords may contain only letters, digits and underscores.

# --- API ---
NODE_ENV=development
# Port the API listens on (default 3000).
API_PORT=3000

# --- Database (used by the API and by docker-compose.yml) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=meet_sync
# Database used by automated tests (the API tests apply migrations to it and delete its rows).
DB_TEST_NAME=meet_sync_test
# Runtime account used by the API: can only read and write rows (no schema changes).
DB_USER=meet_sync_app
DB_PASSWORD=replace_with_a_strong_runtime_password
# Migration account used only by `npm run migrate`: full rights on the application database.
DB_MIGRATION_USER=meet_sync_migrator
DB_MIGRATION_PASSWORD=replace_with_a_strong_migration_password
# Root password of the local Docker container only. Not used by the API.
DB_ROOT_PASSWORD=replace_with_a_strong_root_password
