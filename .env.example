# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.

# --- API ---
NODE_ENV=development
# Port the API listens on (default 3000).
API_PORT=3000

# --- Local MySQL (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=meet_sync
MYSQL_USER=meet_sync_app
MYSQL_PASSWORD=replace_with_a_strong_app_password
# Host port published on 127.0.0.1 (default 3307).
MYSQL_PORT=3307
